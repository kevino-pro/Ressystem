# Kopieer naar .env voor lokale ontwikkeling. Op Render zet je deze als Environment Variables
# in het dashboard (nooit als bestand committen).

# --- BRANDING & RESTAURANT ---
RESTAURANT_NAAM=Mijn Restaurant
RESTAURANT_TAGLINE=Authentiek & Vers
RESTAURANT_EMAIL=info@restaurant.nl
RESTAURANT_TELEFOON=0612345678
PRIMARY_COLOR=#d97706
APP_BASE_URL=https://jouw-app.onrender.com

# --- BUSINESS LOGIC ---
MAX_CAPACITEIT_PER_SLOT=10
MAX_PERSONEN_PER_BOEKING=20
RETENTIE_DAGEN_AVG=60

# --- BEVEILIGING & DATABASE ---
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Neon: gebruik de "Pooled connection" string (PgBouncer), niet de directe, i.v.m. meerdere gunicorn workers
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))" — moet matchen met n8n-config
WEBHOOK_API_KEY=
ADMIN_INITIAL_PASSWORD=

# --- SMTP / E-MAIL ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
VERZENDER_EMAIL=
# Gmail: gebruik een App Password, niet het echte account-wachtwoord
VERZENDER_WACHTWOORD=

# --- AI (ANTHROPIC) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- FLASK ---
# Op Render: laat leeg / false. Alleen "true" voor lokale dev.
FLASK_DEBUG=false
