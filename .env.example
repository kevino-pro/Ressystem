# Kopieer naar .env voor lokale ontwikkeling. Op Render zet je deze als Environment Variables
# in het dashboard (nooit als bestand committen).

# --- RESTAURANT ---
# Naam, e-mail, telefoon, kleur en ondertitel staan in restaurants/<naam>.toml ([restaurant] en [huisstijl]).
APP_BASE_URL=https://jouw-app.onrender.com

# --- BUSINESS LOGIC ---
# Openingstijden, tijdsloten, zitduur en capaciteit staan in een TOML-bestand per restaurant.
RESTAURANT_CONFIG=restaurants/voorbeeld.toml
RETENTIE_DAGEN_AVG=60

# --- SECURITY & DATABASE ---
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Lokale defaults. Op Render: DATABASE_URL is Neon pooled (host bevat -pooler).
DATABASE_URL=sqlite:///reserveringen.db
# Alembic gebruikt lokaal SQLite; stel op Render de directe Neon URL in (host zonder -pooler).
MIGRATION_DATABASE_URL=sqlite:///reserveringen.db
# Alleen inline in de Render Build Command gebruiken; nooit persistent instellen in .env/dashboard.
# ALLOW_PROD_MIGRATE=1
# Stel dezelfde waarde in n8n in als X-API-Key. WEBHOOK_API_KEY blijft als legacy alias ondersteund.
API_KEY=
ADMIN_INITIAL_PASSWORD=

# --- SMTP / E-MAIL ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
VERZENDER_EMAIL=
# Gmail: gebruik een App Password, niet het echte account-wachtwoord
VERZENDER_WACHTWOORD=
# Resend (aanbevolen op Render, want SMTP-poorten zijn daar op gratis plannen geblokkeerd).
# Als deze gezet is, wordt SMTP niet gebruikt.
RESEND_API_KEY=

# --- AI (ANTHROPIC) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- FLASK ---
# Op Render: false. Alleen "true" voor lokale dev.
FLASK_DEBUG=False
